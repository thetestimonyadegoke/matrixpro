      "description": "Measure values to display"
    },
    {
      "name": "SparklineMeasure",
      "displayName": "Sparkline Measure",
      "displayNameKey": "Role_SparklineMeasure",
      "kind": "Measure",
      "description": "Optional measure for sparklines (defaults to first Value)"
    },
    {
      "name": "Tooltips",
      "displayName": "Tooltips",
      "displayNameKey": "Role_Tooltips",
      "kind": "Measure",
      "description": "Optional fields used in tooltips"
    }
  ],
  "dataViewMappings": [
    {
      "conditions": [
        {
          "Rows": {
            "max": 10
          },
          "Columns": {
            "max": 10
          },
          "Values": {
            "max": 20
          },
          "SparklineMeasure": {
            "max": 1
          },
          "Tooltips": {
            "max": 10
          }
        }
      ],
      "matrix": {
        "rows": {
          "for": {
            "in": "Rows"
          },
          "dataReductionAlgorithm": {
            "top": {
              "count": 30000
            }
          }
        },
        "columns": {
          "for": {
            "in": "Columns"
          },
          "dataReductionAlgorithm": {
            "top": {
              "count": 500
            }
          }
        },
        "values": {
          "select": [
            {
              "for": {
                "in": "Values"
              }
            },
            {
              "for": {
                "in": "SparklineMeasure"
              }
            },
            {
              "for": {
                "in": "Tooltips"
              }
            }
          ]
        }
      }
    }
  ],
